<!DOCTYPE html>
<html>

<head>
    <title>Admin Login</title>
</head>

<body>

    <h2>Admin Login</h2>

    <% if (error) { %>

        <p><%= error %></p>

    <% } %>

    <form action="/login" method="POST">

        <label>Username:</label>

        <input
            type="text"
            name="username"
            required
        >

        <br><br>

        <label>Password:</label>

        <input
            type="password"
            name="password"
            required
        >

        <br><br>

        <button type="submit">
            Login
        </button>

    </form>

    <!-- <p>Username: admin</p>
    <p>Password: admin123</p> -->

</body>

</html>