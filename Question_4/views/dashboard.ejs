<!DOCTYPE html>
<html>

<head>
    <title>Admin Dashboard</title>
</head>

<body>

    <h2>Admin Dashboard</h2>

    <a href="/employee/add">
        Add Employee
    </a>

    <br><br>

    <a href="/logout">
        Logout
    </a>

    <br><br>

    <table border="1" cellpadding="10">

        <tr>

            <th>Emp ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th>Basic Salary</th>
            <th>HRA</th>
            <th>DA</th>
            <th>PF</th>
            <th>Net Salary</th>
            <th>Actions</th>

        </tr>


        <% employees.forEach(employee => { %>

            <tr>

                <td>
                    <%= employee.empid %>
                </td>

                <td>
                    <%= employee.name %>
                </td>

                <td>
                    <%= employee.email %>
                </td>

                <td>
                    <%= employee.department %>
                </td>

                <td>
                    <%= employee.basicSalary %>
                </td>

                <td>
                    <%= employee.hra %>
                </td>

                <td>
                    <%= employee.da %>
                </td>

                <td>
                    <%= employee.pf %>
                </td>

                <td>
                    <%= employee.netSalary %>
                </td>

                <td>

                    <a href="/employee/edit/<%= employee._id %>">
                        Edit
                    </a>

                    |

                    <a href="/employee/delete/<%= employee._id %>">
                        Delete
                    </a>

                </td>

            </tr>

        <% }) %>

    </table>

</body>

</html>